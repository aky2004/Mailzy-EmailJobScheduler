# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://outboxlab:outboxlab_secret@localhost:5432/outboxlab_db

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Firebase Admin SDK (Backend) ───────────────────────────────────────
# Download from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ─── Worker Configuration ────────────────────────────────────────────────
WORKER_CONCURRENCY=5
# Minimum delay between individual email sends (milliseconds)
MIN_DELAY_MS=2000
# Maximum emails per hour (global fallback)
MAX_EMAILS_PER_HOUR=200
# Maximum emails per hour per sender
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# ─── Ethereal SMTP (optional – auto-created if blank) ────────────────────
# If left empty, a new Ethereal test account is created on startup
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587

# ─── Server ──────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
